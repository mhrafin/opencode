{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "/home/raf/.config/opencode/plugins/puml-guard",
    "cc-safety-net@latest",
    "opencode-mem@latest"
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": false
      },
      "penpot": {
        "type": "remote",
        "url": "https://design.penpot.app/mcp/stream?userToken={file:.secrets/penpot-token}",
        "oauth": false,
        "disabled": false
      },
      "n8n-mcp": {
        "type": "remote",
        "url": "https://n8n.mhrafin.dev/mcp-server/http",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:.secrets/n8n-mcp-token}"
        },
        "disabled": false
      }
    }
  },

  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git config *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" }
  ],
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-3eec7778affa1558-7d5e26-4dc0922f"
      },
      "models": {
        "gh/auto": {
          "name": "gh/auto",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-3eec7778affa1558-7d5e26-4dc0922f"
      },
      "models": {
        "gh/auto": {
          "name": "gh/auto",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  }
}

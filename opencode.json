{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/home/raf/.penpot-ai-kit/AGENTS.md",
    "/home/raf/.penpot-ai-kit/skills/penpot-router/SKILL.md"
  ],
  "websearch": {
    "provider": "exa"
  },
  "plugins": ["cc-safety-net@latest"],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true
      },
      "penpot": {
        "type": "remote",
        "url": "https://design.penpot.app/mcp/stream?userToken={file:.secrets/penpot-token}",
        "oauth": false,
        "disabled": false
      },
      "n8n-mcp": {
        "type": "remote",
        "url": "https://n8n.mhrafin.dev/mcp-server/http",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:.secrets/n8n-mcp-token}"
        },
        "disabled": false
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "enabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:.secrets/github-pat}"
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "providers": {
    "agentrouter": {
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "https://agentrouter.org/v1/"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol"
        }
      }
    }
  }
}
